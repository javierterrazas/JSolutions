# Copia este archivo como .env.local. Los valores de abajo son los de la base local de `supabase start`.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# La capa del servidor se conecta como ijm_servidor (D-027). En local, la contraseña de supabase/seed.sql.
SERVIDOR_DATABASE_URL=postgresql://ijm_servidor:ijm-servidor-local@127.0.0.1:54322/postgres
