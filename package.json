{
  "name": "ijm",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @ijm/web dev",
    "build": "pnpm --filter @ijm/web build",
    "test": "vitest run",
    "test:unidad": "vitest run --project unidad",
    "test:paridad": "vitest run --project paridad",
    "test:rls": "vitest run --project rls",
    "test:integracion": "vitest run --project integracion",
    "e2e": "echo \"Playwright llega en la fase 2, con las pantallas.\"",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start -x studio,postgres-meta,realtime,imgproxy,edge-runtime,logflare,vector,mailpit,supavisor",
    "db:start:completo": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.9.9",
    "supabase": "^2.119.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
