# Copia este archivo como apps/web/.env.local. Los valores de la base local salen de `pnpm exec supabase status`.
# En Vercel van las mismas variables, con los valores de la nube. Ninguna llave va en el repositorio.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# La capa del servidor se conecta como ijm_servidor (D-027). En local, la contraseña de supabase/seed.sql.
SERVIDOR_DATABASE_URL=postgresql://ijm_servidor:ijm-servidor-local@127.0.0.1:54322/postgres
# Supabase Auth (D-038). La llave secreta solo la usa el servidor; nunca va a una variable NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=la PUBLISHABLE_KEY de supabase status
SUPABASE_SECRET_KEY=la SECRET_KEY de supabase status
